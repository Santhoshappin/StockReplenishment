@page "/locations"
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Class="mb-4">Stock Locations</MudText>

@if (CurrentUser?.Role != UserRole.Reviewer)
{
    <MudAlert Severity="Severity.Warning" Style="max-width:700px">
        Only reviewers can manage stock locations — switch user in the top bar.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" Style="max-width:700px">
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField @bind-Value="_code" Label="Code" Style="max-width:160px" />
            <MudTextField @bind-Value="_name" Label="Name" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">
                @(_editingId is null ? "Add" : "Update")
            </MudButton>
            @if (_editingId is not null)
            {
                <MudButton OnClick="CancelEdit">Cancel</MudButton>
            }
        </MudStack>
    </MudPaper>

    <MudTable T="StockLocation" Items="_locations" Style="max-width:700px" Hover>
        <HeaderContent>
            <MudTh>Code</MudTh>
            <MudTh>Name</MudTh>
            <MudTh Style="width:110px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="() => StartEdit(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="() => DeleteAsync(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter] private AppUser? CurrentUser { get; set; }

    private List<StockLocation> _locations = [];
    private Guid? _editingId;
    private string _code = "";
    private string _name = "";
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        _locations = await Http.GetFromJsonAsync<List<StockLocation>>("api/locations", AppJson.Options) ?? [];

    private void StartEdit(StockLocation location)
    {
        _editingId = location.Id;
        _code = location.Code;
        _name = location.Name;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _code = _name = "";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Code and name are both required.", Severity.Warning);
            return;
        }

        _busy = true;
        var dto = new UpsertLocationDto(_code, _name);
        HttpResponseMessage response;
        try
        {
            response = _editingId is { } id
                ? await Http.PutAsJsonAsync($"api/locations/{id}", dto, AppJson.Options)
                : await Http.PostAsJsonAsync("api/locations", dto, AppJson.Options);
        }
        finally
        {
            _busy = false;
        }

        if (response.IsSuccessStatusCode)
        {
            CancelEdit();
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(await ApiError.ReadAsync(response), Severity.Error);
        }
    }

    private async Task DeleteAsync(StockLocation location)
    {
        var response = await Http.DeleteAsync($"api/locations/{location.Id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(await ApiError.ReadAsync(response), Severity.Error);
        }
    }
}
